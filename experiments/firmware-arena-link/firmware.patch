diff --git a/core/embed/projects/firmware/src/synthetic_approval.rs b/core/embed/projects/firmware/src/synthetic_approval.rs
new file mode 100644
index 0000000..3915e88
--- /dev/null
+++ b/core/embed/projects/firmware/src/synthetic_approval.rs
@@ -0,0 +1,57 @@
+//! NEVER EXECUTE/FLASH: fixed public-data, automatically approved boot
+//! diagnostic. The 4 KiB seed cannot hold the lifecycle or image-lifetime
+//! public lazy Fp tables. This module makes no cleanup, runtime capacity or
+//! device-safety claim.
+use core::hint::black_box;
+use core::ptr;
+
+use ironwood_approval::{Engine, Error, Policy, Result};
+use orchard::keys::{FullViewingKey, SpendAuthorizingKey, SpendingKey};
+use rand_chacha::ChaCha20Rng;
+use rand_chacha::rand_core::SeedableRng;
+
+static FIXTURE: &[u8] = include_bytes!("outputs-1.pczt");
+#[unsafe(no_mangle)]
+static mut IRONWOOD_DIAGNOSTIC_RESULT: usize = 0;
+
+// Parameterless and reachable only from reset_handler; never a generic host
+// API.
+#[unsafe(no_mangle)]
+#[inline(never)]
+pub extern "C" fn ironwood_synthetic_boot() {
+    crate::arena::init();
+    let result = synthetic_approval();
+    let consumed = match black_box(result) {
+        Ok(length) => length,
+        Err(_) => usize::MAX,
+    };
+    unsafe { ptr::addr_of_mut!(IRONWOOD_DIAGNOSTIC_RESULT).write_volatile(consumed) };
+}
+
+#[inline(never)]
+fn synthetic_approval() -> Result<usize> {
+    let spending = SpendingKey::from_bytes(black_box([0; 32])).unwrap();
+    let ask = SpendAuthorizingKey::from(&spending);
+    let mut engine = Engine::with_rng(
+        Policy::regtest(black_box(10_000_000), black_box(100_000))?,
+        FullViewingKey::from(&spending),
+        ChaCha20Rng::from_seed(black_box([42; 32])),
+    )?;
+    let review = black_box(&mut engine).begin(black_box(FIXTURE))?;
+    // ONLY this synthetic compile-only boot diagnostic auto-approves.
+    black_box(&mut engine).approve(black_box(review.token()))?;
+    let signed = black_box(&mut engine).sign(black_box(review.token()), black_box(&ask))?;
+    let serialized = black_box(signed.pczt)
+        .serialize()
+        .map_err(|_| Error("synthetic serialization"))?;
+    // Consume the complete signed bytes before dropping local owners; no export.
+    black_box((
+        &review,
+        &engine,
+        &signed.token,
+        &signed.sighash,
+        &signed.signatures,
+        serialized.as_slice(),
+    ));
+    Ok(black_box(serialized.len()))
+}
