diff --git a/core/embed/projects/firmware/src/arena.rs b/core/embed/projects/firmware/src/arena.rs
new file mode 100644
index 0000000..f860af0
--- /dev/null
+++ b/core/embed/projects/firmware/src/arena.rs
@@ -0,0 +1,93 @@
+//! Compile/link diagnostic, derived from frozen/experiment/src/arena.rs in
+//! work/arena-probe (SHA-256 recorded in protected-source-before.json).
+//! Removed native driver, tests and counters. No GC/system allocator fallback.
+use core::alloc::{GlobalAlloc, Layout};
+use core::mem::{MaybeUninit, size_of};
+use core::ptr::{self, NonNull};
+
+use linked_list_allocator::Heap;
+use spin::mutex::{SpinMutex, SpinMutexGuard};
+
+const CAPACITY: usize = 4096;
+// The upstream documented maximum minimum is three machine words, including
+// start alignment. This seed must never become a runtime allocation budget.
+const _: () = assert!(CAPACITY >= 3 * size_of::<usize>());
+
+#[repr(C, align(16))]
+struct Storage([MaybeUninit<u8>; CAPACITY]);
+
+#[unsafe(no_mangle)]
+static mut IRONWOOD_DIAGNOSTIC_ARENA: Storage = Storage([MaybeUninit::new(0); CAPACITY]);
+
+struct Arena(SpinMutex<Heap>);
+
+#[global_allocator]
+static ALLOCATOR: Arena = Arena(SpinMutex::new(Heap::empty()));
+
+#[cold]
+#[inline(never)]
+#[unsafe(no_mangle)]
+fn ironwood_arena_fail_stop() -> ! {
+    // Immediate ARM undefined-instruction trap; no formatter, callback or GC.
+    // No recovery/reuse contract, and never executed by this compile-only task.
+    unsafe { core::arch::asm!("udf #0", options(noreturn, nomem, nostack)) }
+}
+
+impl Arena {
+    fn lock(&self) -> SpinMutexGuard<'_, Heap> {
+        self.0
+            .try_lock()
+            .unwrap_or_else(|| ironwood_arena_fail_stop())
+    }
+
+    fn lock_initialized_heap(&self) -> SpinMutexGuard<'_, Heap> {
+        let heap = self.lock();
+        if heap.bottom().is_null() {
+            ironwood_arena_fail_stop();
+        }
+        heap
+    }
+}
+
+pub fn init() {
+    let mut heap = ALLOCATOR.lock();
+    // The ONLY initialization state; check before making the unique slice.
+    if !heap.bottom().is_null() {
+        ironwood_arena_fail_stop();
+    }
+    // SAFETY: the first boot call owns this BSS storage exclusively. Under the
+    // same lock, bottom proves no previous slice exists. Never reset or extend.
+    unsafe {
+        let bytes = ptr::addr_of_mut!(IRONWOOD_DIAGNOSTIC_ARENA).cast::<MaybeUninit<u8>>();
+        heap.init_from_slice(core::slice::from_raw_parts_mut(bytes, CAPACITY));
+    }
+}
+
+unsafe impl GlobalAlloc for Arena {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // GlobalAlloc callers supply a valid, nonzero Layout.
+        // Obscures the fixed request from optimization; verify validation/signing
+        // reachability in the final ELF.
+        let layout = core::hint::black_box(layout);
+        self.lock_initialized_heap()
+            .allocate_first_fit(layout)
+            .map_or(ptr::null_mut(), NonNull::as_ptr)
+    }
+
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+        // SAFETY: GlobalAlloc requires an owned, nonnull live pointer and its
+        // exact current Layout. No foreign/GC pointers enter this allocator.
+        unsafe {
+            self.lock_initialized_heap()
+                .deallocate(NonNull::new_unchecked(pointer), layout);
+        }
+    }
+    // Inherit alloc_zeroed/realloc: no lock is held across their zero/copy work.
+}
+
+#[alloc_error_handler]
+fn allocation_error(_: Layout) -> ! {
+    // The pinned nightly's immediate-abort handle_alloc_error normally traps
+    // directly, bypassing this shim. Verify actual retained paths in the ELF.
+    ironwood_arena_fail_stop()
+}
